{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run js:check && npm run workflows:check && npm run navigation-icons:check && npm run anchors:check && npm run interface:check && npm run safari:check && npm run widget-sync:check && npm run translations:check && npm run customer-support:check && npm run fern:check",
    "workflows:check": "node --test scripts/check-workflows.test.mjs scripts/check-workflows-translations.test.mjs",
    "fern:check": "fern check --warnings",
    "fern:dev": "fern docs dev",
    "prefern:publish": "npm run check",
    "fern:publish": "fern generate --docs",
    "js:check": "node scripts/check-javascript.mjs",
    "browser:check": "npm --prefix tests/browser test",
    "widget-sync:check": "node scripts/check-widget-sync.mjs",
    "translations:generate": "node scripts/generate-translations.mjs",
    "posttranslations:generate": "node scripts/stabilize-heading-anchors.mjs",
    "translations:polish": "node scripts/polish-core-translations.mjs",
    "posttranslations:polish": "node scripts/stabilize-heading-anchors.mjs",
    "translations:refresh-manifest": "node scripts/generate-translations.mjs --refresh-manifest",
    "translations:repair-links": "node scripts/repair-translation-links.mjs",
    "translations:check": "node scripts/check-translation-prefixes.mjs && node scripts/check-translations.mjs",
    "check:preview": "npm run check",
    "preview:prediction": "node scripts/preview-prediction.mjs",
    "anchors:check": "node scripts/stabilize-heading-anchors.mjs --check",
    "interface:check": "node scripts/check-docs-interface.mjs",
    "navigation-icons:check": "node --test scripts/check-navigation-icons.test.mjs && node scripts/check-navigation-icons.mjs",
    "customer-support:check": "node scripts/check-customer-support.mjs",
    "safari:check": "node --test scripts/check-safari-hydration.test.mjs"
  },
  "engines": {
    "node": ">=20.0"
  },
  "devDependencies": {
    "fern-api": "5.143.1",
    "yaml": "2.9.1"
  }
}
